# Lexiom 1.3 Virtualized Agent Loop — Docker Engine for Aider bind-mount sandbox
# Node process shells out to `docker run`. Requires docker group / daemon access on EB.
packages:
  yum:
    docker: []

commands:
  01_docker_start:
    command: "service docker start || systemctl start docker || true"
    ignoreErrors: true
  02_docker_enable:
    command: "chkconfig docker on || systemctl enable docker || true"
    ignoreErrors: true

container_commands:
  01_note_agent_runtime:
    command: "echo '[gt3] Docker packages present; npm install postinstall will pull GT3_AIDER_DOCKER_IMAGE and write .gt3-agent-runtime/BRINGUP_STATUS.json'"
    ignoreErrors: true
  02_docker_group_webapp:
    command: "usermod -a -G docker webapp || usermod -a -G docker ec2-user || true"
    ignoreErrors: true
