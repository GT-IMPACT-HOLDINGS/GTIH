{
  "name": "gt3-poc-node",
  "version": "0.2.0",
  "description": "GT3 POC server (Node.js) â€” dual-variant inference with ledger logging and multiple LLM providers",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node scripts/gt3-agent-runtime-install.mjs",
