# OpenRouter Provisioning API Key
# Get this from: https://openrouter.ai/settings/provisioning-keys
# This key is used to create per-install API keys for QuoteMe users
OPENROUTER_PROVISIONING_KEY=sk-or-provision-your-key-here

# GT3 inference tunnel (default: OpenRouter → openai/gpt-4o-mini)
# Loaded automatically by `npm start` (dotenv). Never commit real keys.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
GT3_OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# Optional: browser-only demo tenant (ODD, Lexiom) when no client key is sent
# GT3_LEXIOM_DEMO_KEY=sk-or-v1-demo-key-here
# GT3_INFERENCE_MODE=loving_only

# Lexiom 1.3 agent broker (POST /v1/chat/completions → OpenRouter → Claude)
# Prefer a separate key from DEMO/product for OpenRouter cost split.
# GT3_LEXIOM_AGENT_KEY=sk-or-v1-agent-key-here
# Seeds the MBTS (Model Behind The Scene). The GT3 admin may retarget it at runtime
# from the ops console; a restart returns to this value.
# GT3_AGENT_OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# GT3_AGENT_OPENROUTER_MODEL=openai/gpt-5.5
# OpenRouter app attribution. Ogun (owned by GTIH.pbc) is the application;
# Hanuman is the agent that runs builds inside it. GT3 appends a lane path so the
# OpenRouter "App" column separates /hanuman-build from /evidence-collection.
# Unset defaults to https://gtih.pbc/ogun.
# GT3_HTTP_REFERER=https://gtih.pbc/ogun
# Anthropic-style explicit prompt caching (cache_control breakpoints). Anthropic MBTS only.
# OpenAI reasoning models cache automatically above ~1024 prompt tokens and need no flag.
# Either way GT3 always sends session_id / prompt_cache_key for sticky routing.
# Correctness must never depend on a hit.
# GT3_AGENT_PROMPT_CACHE=1
# Redacted full request/response capture ceiling for each agent LM text surface.
# GT3_AGENT_OBSERVABILITY_MAX_CHARS=2000000
# Product CA executor is bolt_webcontainer (browser WebContainer) — no Docker required.
# Follow-up only: GT3_AIDER_DOCKER_IMAGE=paulgauthier/aider

# Lexiom 1.4 embedded SaaS (vertical SDK / TRH)
# GT3_LEXIOM14_DEMO_SECRET=lexiom14-dev-secret
# Comma-separated TRH/smoke origins for /lexiom14 CORS (defaults include :4173 and :8080)
# GT3_LEXIOM14_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080

# Optional local cockpit override (also: Lexiom URL ?or_key=… stores into localStorage lexiom_gt3_api_key)
# Browser may send that value as X-GT3-OpenRouter-Key on /run and broker hops when server env keys are unset.
